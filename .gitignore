node_modules
dist/
build/
coverage/
.DS_Store
*.log
.env
.env.*
!.env.example

# Bun
bun.lockb
# Install cache that `bun install` writes into the checkout root. Untracked, it
# leaves every isolated-install worktree dirty after an install.
.bun/

# TypeScript
*.tsbuildinfo
# Reject stray .js/.d.ts emission into src/ — packages must emit to dist/.
# A misconfigured `tsc` invocation (no --build, wrong cwd) can drop emits next
# to source; bun then resolves `./foo.js` to the stale emit instead of the .ts.
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
# Also reject stray emits dropped at a package root (e.g. a bare `tsc` on a
# root-level test-utils.ts) — the src/ globs above don't reach package roots.
packages/*/*.js
packages/*/*.d.ts

# Local state
.penumbra/
tmp/
local_cache/
**/local_cache/

# Bench scratch
/test-bench-*.jsonl

# Runtime / tooling output, not source: session notes (notes rotate),
# plan-writer output, and lint baselines. Kept out of the public repo.
docs/notes/
docs/plans/
docs/quality/

# Stray local agent/editor config symlinks
.antigravitycli/
# Generated read-only memory view written by tooling, not source.
# Narrow on purpose: tracked .claude/ paths (workflows/, settings*.json) stay tracked.
.claude/projects/
# Root-level macOS cache artifact from fleet worktrees
/Library/
