{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "penumbra-exec-primitives": ["./src/index.ts"],
      "@penumbra/*": ["./qualification/stubs/penumbra-poison.d.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "qualification/**/*"],
  "exclude": ["qualification/audit-fixtures/**", "qualification/mutations/**"]
}
