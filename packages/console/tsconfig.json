{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@src/*": ["./src/*"] },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "visual/**/*.ts"],
  "exclude": ["visual/**/*.spec.ts"],
  "references": [{ "path": "../api-contract" }]
}
