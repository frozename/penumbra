{
  "mcpServers": {
    "penumbra": {
      "type": "stdio",
      "command": "bun",
      "args": ["packages/mcp/bin/penumbra-mcp.ts"],
      "env": {
        "PENUMBRA_MCP_INVOCATION_LOG_ENABLED": "1",
        "PENUMBRA_MCP_ORIGIN": "maestro",
        "PENUMBRA_MCP_RESPONSE_BUDGET_TOKENS": "8000"
      }
    }
  }
}
