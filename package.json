{
  "name": "penumbra",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/integrations/*"
  ],
  "scripts": {
    "test": "bun test",
    "dist-check": "bun scripts/check-dist-freshness.ts",
    "deps-check": "bun scripts/check-external-deps.ts",
    "postinstall": "bun scripts/check-external-deps.ts",
    "lint:no-raw-env": "bun scripts/lint/no-raw-env.ts",
    "lint:no-sync-exec": "bun scripts/lint/no-sync-exec.ts",
    "typecheck": "bun scripts/check-dist-freshness.ts && tsc --build",
    "lint": "bun run lint:no-raw-env && bun run lint:no-sync-exec && eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint packages/config packages/api-contract packages/agy-acp-shim packages/agentchat packages/e2e packages/workflows packages/cli packages/console packages/core packages/mcp packages/daemon packages/integrations/sirius-middleware scripts --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.3.13",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.3.0"
  },
  "overrides": {
    "fastembed": {
      "tar": "^6.2.1"
    }
  },
  "lint-staged": {
    "*.{ts,mjs,json,md}": "prettier --write"
  }
}
